# Konfigurasi environment KasirQu.
# Salin file ini menjadi `.env.local` (atau `.env`) lalu isi nilainya.
# JANGAN commit `.env` / `.env.local` (sudah di-ignored oleh .gitignore).

# --- Database (Neon Postgres) ---
# Koneksi ke Neon. Pakai endpoint "pooled" (-pooler) untuk aplikasi.
DATABASE_URL=

# --- Neon Object Storage (S3-compatible) ---
# Ambil endpoint dan access key dari dashboard Neon; jangan commit nilai rahasia.
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_OBJECT_STORAGE_BUCKET=gambar

# --- Sesi login ---
# Secret untuk menandatangani cookie sesi (HMAC-SHA256).
# WAJIB, minimal 32 karakter. Hasilkan misalnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# --- Akun admin awal (opsional, hanya dibuat jika username belum ada) ---
SEED_ADMIN_NAME=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
